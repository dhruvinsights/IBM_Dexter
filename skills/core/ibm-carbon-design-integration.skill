### 2. Data Display Components

#### Data Table for Pull Requests
```typescript
import {
  DataTable,
  Table,
  TableHead,
  TableRow,
  TableHeader,
  TableBody,
  TableCell,
  TableContainer,
  TableToolbar,
  TableToolbarContent,
  TableToolbarSearch,
  TableBatchActions,
  TableBatchAction,
  TableSelectAll,
  TableSelectRow,
  Pagination,
  Tag
} from '@carbon/react';
import { TrashCan, Download } from '@carbon/icons-react';

interface PullRequest {
  id: string;
  title: string;
  author: string;
  status: 'open' | 'merged' | 'closed';
  reviewScore: number;
  createdAt: string;
}

const headers = [
  { key: 'title', header: 'Pull Request' },
  { key: 'author', header: 'Author' },
  { key: 'status', header: 'Status' },
  { key: 'reviewScore', header: 'AI Review Score' },
  { key: 'createdAt', header: 'Created' }
];

export function PullRequestTable({ rows }: { rows: PullRequest[] }) {
  return (
    <DataTable rows={rows} headers={headers}>
      {({
        rows,
        headers,
        getHeaderProps,
        getRowProps,
        getTableProps,
        getTableContainerProps,
        getToolbarProps,
        getBatchActionProps,
        getSelectionProps,
        selectedRows
      }) => (
        <TableContainer {...getTableContainerProps()}>
          <TableToolbar {...getToolbarProps()}>
            <TableBatchActions {...getBatchActionProps()}>
              <TableBatchAction
                renderIcon={TrashCan}
                onClick={() => console.log('Delete selected')}
              >
                Delete
              </TableBatchAction>
              <TableBatchAction
                renderIcon={Download}
                onClick={() => console.log('Export selected')}
              >
                Export
              </TableBatchAction>
            </TableBatchActions>
            <TableToolbarContent>
              <TableToolbarSearch
                placeholder="Search pull requests"
                onChange={(e) => console.log(e.target.value)}
              />
            </TableToolbarContent>
          </TableToolbar>
          <Table {...getTableProps()}>
            <TableHead>
              <TableRow>
                <TableSelectAll {...getSelectionProps()} />
                {headers.map((header) => (
                  <TableHeader {...getHeaderProps({ header })}>
                    {header.header}
                  </TableHeader>
                ))}
              </TableRow>
            </TableHead>
            <TableBody>
              {rows.map((row) => (
                <TableRow {...getRowProps({ row })}>
                  <TableSelectRow {...getSelectionProps({ row })} />
                  {row.cells.map((cell) => (
                    <TableCell key={cell.id}>
                      {cell.info.header === 'status' ? (
                        <Tag type={getStatusType(cell.value)}>
                          {cell.value}
                        </Tag>
                      ) : (
                        cell.value
                      )}
                    </TableCell>
                  ))}
                </TableRow>
              ))}
            </TableBody>
          </Table>
          <Pagination
            backwardText="Previous page"
            forwardText="Next page"
            itemsPerPageText="Items per page:"
            page={1}
            pageSize={10}
            pageSizes={[10, 20, 30, 40, 50]}
            totalItems={rows.length}
          />
        </TableContainer>
      )}
    </DataTable>
  );
}
```

#### Tile Components for Metrics
```typescript
import { Tile, ClickableTile } from '@carbon/react';
import { ArrowUp, ArrowDown } from '@carbon/icons-react';

interface MetricTileProps {
  title: string;
  value: string | number;
  change?: number;
  description?: string;
  onClick?: () => void;
}

export function MetricTile({
  title,
  value,
  change,
  description,
  onClick
}: MetricTileProps) {
  const TileComponent = onClick ? ClickableTile : Tile;
  
  return (
    <TileComponent onClick={onClick}>
      <div className="metric-tile">
        <h4 className="metric-title">{title}</h4>
        <div className="metric-value">{value}</div>
        {change !== undefined && (
          <div className={`metric-change ${change >= 0 ? 'positive' : 'negative'}`}>
            {change >= 0 ? <ArrowUp size={16} /> : <ArrowDown size={16} />}
            <span>{Math.abs(change)}%</span>
          </div>
        )}
        {description && <p className="metric-description">{description}</p>}
      </div>
    </TileComponent>
  );
}
```

### 3. Form Components

#### Repository Configuration Form
```typescript
import {
  Form,
  FormGroup,
  TextInput,
  Select,
  SelectItem,
  Checkbox,
  Button,
  Stack
} from '@carbon/react';

export function RepositoryConfigForm() {
  return (
    <Form>
      <Stack gap={6}>
        <FormGroup legendText="Repository Details">
          <TextInput
            id="repo-name"
            labelText="Repository Name"
            placeholder="Enter repository name"
            required
          />
          <TextInput
            id="repo-url"
            labelText="Repository URL"
            placeholder="https://github.com/org/repo"
            required
          />
        </FormGroup>

        <FormGroup legendText="Review Settings">
          <Select
            id="review-level"
            labelText="Review Level"
            defaultValue="standard"
          >
            <SelectItem value="basic" text="Basic" />
            <SelectItem value="standard" text="Standard" />
            <SelectItem value="comprehensive" text="Comprehensive" />
          </Select>

          <Checkbox
            id="auto-review"
            labelText="Enable automatic PR review"
            defaultChecked
          />
          <Checkbox
            id="security-scan"
            labelText="Enable security scanning"
            defaultChecked
          />
          <Checkbox
            id="code-quality"
            labelText="Enable code quality checks"
            defaultChecked
          />
        </FormGroup>

        <FormGroup legendText="AI Agent Configuration">
          <Select
            id="ai-model"
            labelText="AI Model"
            defaultValue="gpt-4"
          >
            <SelectItem value="gpt-4" text="GPT-4" />
            <SelectItem value="gpt-3.5" text="GPT-3.5 Turbo" />
            <SelectItem value="claude" text="Claude" />
          </Select>
        </FormGroup>

        <div className="form-actions">
          <Button kind="secondary">Cancel</Button>
          <Button kind="primary" type="submit">
            Save Configuration
          </Button>
        </div>
      </Stack>
    </Form>
  );
}
```

### 4. Notification Components

#### Toast Notifications
```typescript
import { ToastNotification, InlineNotification } from '@carbon/react';

export function ReviewCompleteNotification() {
  return (
    <ToastNotification
      kind="success"
      title="Review Complete"
      subtitle="AI review completed successfully for PR #123"
      timeout={5000}
      onClose={() => console.log('Notification closed')}
    />
  );
}

export function SecurityWarning() {
  return (
    <InlineNotification
      kind="warning"
      title="Security Issues Found"
      subtitle="3 potential security vulnerabilities detected in this PR"
      lowContrast
    />
  );
}

export function ErrorNotification({ message }: { message: string }) {
  return (
    <InlineNotification
      kind="error"
      title="Error"
      subtitle={message}
      lowContrast
    />
  );
}
```


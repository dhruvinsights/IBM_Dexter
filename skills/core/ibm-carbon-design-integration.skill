## Common Patterns and Best Practices

### 1. When to Use Which Component

**Tiles vs Cards:**
- Use `Tile` for simple content containers
- Use `ClickableTile` for interactive cards
- Use `ExpandableTile` for collapsible content

**Tables vs Lists:**
- Use `DataTable` for complex, sortable, filterable data
- Use `StructuredList` for simple key-value pairs
- Use `OrderedList` or `UnorderedList` for basic lists

**Modals vs Side Panels:**
- Use `Modal` for critical actions requiring user attention
- Use side panels (custom) for contextual information

### 2. Form Validation Patterns
```typescript
import { TextInput, Form } from '@carbon/react';
import { useState } from 'react';

export function ValidatedForm() {
  const [errors, setErrors] = useState<Record<string, string>>({});

  const validate = (name: string, value: string) => {
    // Validation logic
    if (!value) {
      setErrors(prev => ({ ...prev, [name]: 'This field is required' }));
    } else {
      setErrors(prev => {
        const newErrors = { ...prev };
        delete newErrors[name];
        return newErrors;
      });
    }
  };

  return (
    <Form>
      <TextInput
        id="repo-name"
        labelText="Repository Name"
        invalid={!!errors.repoName}
        invalidText={errors.repoName}
        onChange={(e) => validate('repoName', e.target.value)}
      />
    </Form>
  );
}
```

### 3. Loading State Management
```typescript
import { useState, useEffect } from 'react';
import { Loading, InlineLoading } from '@carbon/react';

export function DataFetchingComponent() {
  const [loading, setLoading] = useState(true);
  const [data, setData] = useState(null);

  useEffect(() => {
    fetchData().then(result => {
      setData(result);
      setLoading(false);
    });
  }, []);

  if (loading) {
    return <Loading description="Loading data..." withOverlay />;
  }

  return <div>{/* Render data */}</div>;
}
```

### 4. Error Handling
```typescript
import { InlineNotification } from '@carbon/react';
import { useState } from 'react';

export function ErrorBoundaryComponent() {
  const [error, setError] = useState<string | null>(null);

  const handleError = (err: Error) => {
    setError(err.message);
    // Log to error tracking service
  };

  if (error) {
    return (
      <InlineNotification
        kind="error"
        title="Error"
        subtitle={error}
        onClose={() => setError(null)}
      />
    );
  }

  return <div>{/* Component content */}</div>;
}
```

## Testing Carbon Components

### 1. Unit Testing
```typescript
import { render, screen } from '@testing-library/react';
import { MetricTile } from './MetricTile';

describe('MetricTile', () => {
  it('renders metric value correctly', () => {
    render(<MetricTile title="Active PRs" value={24} />);
    expect(screen.getByText('24')).toBeInTheDocument();
  });

  it('shows positive change indicator', () => {
    render(<MetricTile title="Active PRs" value={24} change={12} />);
    expect(screen.getByText('12%')).toBeInTheDocument();
  });
});
```

### 2. Accessibility Testing
```typescript
import { axe, toHaveNoViolations } from 'jest-axe';

expect.extend(toHaveNoViolations);

describe('Accessibility', () => {
  it('should not have accessibility violations', async () => {
    const { container } = render(<DexterDashboard />);
    const results = await axe(container);
    expect(results).toHaveNoViolations();
  });
});
```

## Migration Guide

### From Custom Components to Carbon

1. **Replace custom buttons:**
```typescript
// Before
<button className="primary-btn">Submit</button>

// After
<Button kind="primary">Submit</Button>
```

2. **Replace custom inputs:**
```typescript
// Before
<input type="text" placeholder="Enter name" />

// After
<TextInput id="name" labelText="Name" placeholder="Enter name" />
```

3. **Replace custom modals:**
```typescript
// Before
<CustomModal isOpen={open} onClose={handleClose}>
  {content}
</CustomModal>

// After
<Modal open={open} onRequestClose={handleClose}>
  <ModalBody>{content}</ModalBody>
</Modal>
```


## Setup and Configuration

### 1. Global Styles Setup
Create a global SCSS file to import Carbon styles:

```scss
// styles/globals.scss
@use '@carbon/react';
@use '@carbon/react/scss/themes';
@use '@carbon/react/scss/theme' with (
  $theme: themes.$g100
);

// Include Carbon styles
@include react.theme();
@include react.reset();

// IBM Plex Sans font
@import '@ibm/plex/css/ibm-plex.css';
```

### 2. Theme Configuration
```typescript
// lib/carbon-theme.ts
import { Theme } from '@carbon/react';

export const lightTheme = {
  theme: 'white',
  tokens: {
    // Custom token overrides
  }
};

export const darkTheme = {
  theme: 'g100',
  tokens: {
    // Custom token overrides
  }
};

export const getTheme = (isDark: boolean): Theme => {
  return isDark ? darkTheme : lightTheme;
};
```

### 3. Next.js Integration
```typescript
// app/layout.tsx
import '@/styles/globals.scss';
import { Theme } from '@carbon/react';

export default function RootLayout({
  children,
}: {
  children: React.ReactNode;
}) {
  return (
    <html lang="en">
      <body>
        <Theme theme="g100">
          {children}
        </Theme>
      </body>
    </html>
  );
}
```

## Core Carbon Components for IBM Dexter

### 1. Layout Components

#### Header Navigation
```typescript
import {
  Header,
  HeaderName,
  HeaderNavigation,
  HeaderMenuItem,
  HeaderGlobalBar,
  HeaderGlobalAction,
  SkipToContent
} from '@carbon/react';
import { Notification, UserAvatar, Search } from '@carbon/icons-react';

export function DexterHeader() {
  return (
    <Header aria-label="IBM Dexter">
      <SkipToContent />
      <HeaderName href="/" prefix="IBM">
        Dexter AI Code Reviewer
      </HeaderName>
      <HeaderNavigation aria-label="Main navigation">
        <HeaderMenuItem href="/dashboard">Dashboard</HeaderMenuItem>
        <HeaderMenuItem href="/repositories">Repositories</HeaderMenuItem>
        <HeaderMenuItem href="/pull-requests">Pull Requests</HeaderMenuItem>
        <HeaderMenuItem href="/analytics">Analytics</HeaderMenuItem>
        <HeaderMenuItem href="/agents">AI Agents</HeaderMenuItem>
      </HeaderNavigation>
      <HeaderGlobalBar>
        <HeaderGlobalAction aria-label="Search" tooltipAlignment="end">
          <Search size={20} />
        </HeaderGlobalAction>
        <HeaderGlobalAction aria-label="Notifications" tooltipAlignment="end">
          <Notification size={20} />
        </HeaderGlobalAction>
        <HeaderGlobalAction aria-label="User Profile" tooltipAlignment="end">
          <UserAvatar size={20} />
        </HeaderGlobalAction>
      </HeaderGlobalBar>
    </Header>
  );
}
```

#### Side Navigation
```typescript
import {
  SideNav,
  SideNavItems,
  SideNavLink,
  SideNavMenu,
  SideNavMenuItem
} from '@carbon/react';
import {
  Dashboard,
  Code,
  Analytics,
  Security,
  Settings
} from '@carbon/icons-react';

export function DexterSideNav() {
  return (
    <SideNav aria-label="Side navigation" isFixedNav expanded>
      <SideNavItems>
        <SideNavLink renderIcon={Dashboard} href="/dashboard">
          Dashboard
        </SideNavLink>
        <SideNavMenu renderIcon={Code} title="Code Review">
          <SideNavMenuItem href="/pull-requests">Pull Requests</SideNavMenuItem>
          <SideNavMenuItem href="/code-quality">Code Quality</SideNavMenuItem>
          <SideNavMenuItem href="/diff-viewer">Diff Viewer</SideNavMenuItem>
        </SideNavMenu>
        <SideNavMenu renderIcon={Analytics} title="Analytics">
          <SideNavMenuItem href="/metrics">Metrics</SideNavMenuItem>
          <SideNavMenuItem href="/trends">Trends</SideNavMenuItem>
          <SideNavMenuItem href="/reports">Reports</SideNavMenuItem>
        </SideNavMenu>
        <SideNavLink renderIcon={Security} href="/security">
          Security Findings
        </SideNavLink>
        <SideNavLink renderIcon={Settings} href="/settings">
          Settings
        </SideNavLink>
      </SideNavItems>
    </SideNav>
  );
}
```


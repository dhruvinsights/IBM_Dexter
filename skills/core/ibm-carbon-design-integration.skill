### 2. Code Diff Viewer
```typescript
import { CodeSnippet, Tabs, TabList, Tab, TabPanels, TabPanel } from '@carbon/react';
import { Checkmark, Warning, Error } from '@carbon/icons-react';

interface DiffViewerProps {
  before: string;
  after: string;
  issues: Array<{
    line: number;
    severity: 'error' | 'warning' | 'info';
    message: string;
  }>;
}

export function CodeDiffViewer({ before, after, issues }: DiffViewerProps) {
  return (
    <div className="diff-viewer">
      <Tabs>
        <TabList aria-label="Code diff tabs">
          <Tab>Side by Side</Tab>
          <Tab>Unified</Tab>
          <Tab>Issues ({issues.length})</Tab>
        </TabList>
        <TabPanels>
          <TabPanel>
            <Grid>
              <Column lg={8}>
                <h4>Before</h4>
                <CodeSnippet type="multi" feedback="Copied">
                  {before}
                </CodeSnippet>
              </Column>
              <Column lg={8}>
                <h4>After</h4>
                <CodeSnippet type="multi" feedback="Copied">
                  {after}
                </CodeSnippet>
              </Column>
            </Grid>
          </TabPanel>
          <TabPanel>
            <CodeSnippet type="multi" feedback="Copied">
              {/* Unified diff */}
            </CodeSnippet>
          </TabPanel>
          <TabPanel>
            <div className="issues-list">
              {issues.map((issue, index) => (
                <InlineNotification
                  key={index}
                  kind={issue.severity}
                  title={`Line ${issue.line}`}
                  subtitle={issue.message}
                  lowContrast
                />
              ))}
            </div>
          </TabPanel>
        </TabPanels>
      </Tabs>
    </div>
  );
}
```

### 3. AI Agent Status Indicator
```typescript
import { Tag, ProgressIndicator, ProgressStep } from '@carbon/react';

interface AgentStatusProps {
  status: 'idle' | 'analyzing' | 'reviewing' | 'complete' | 'error';
  currentStep?: number;
}

export function AIAgentStatus({ status, currentStep = 0 }: AgentStatusProps) {
  const getStatusTag = () => {
    switch (status) {
      case 'idle':
        return <Tag type="gray">Idle</Tag>;
      case 'analyzing':
        return <Tag type="blue">Analyzing</Tag>;
      case 'reviewing':
        return <Tag type="purple">Reviewing</Tag>;
      case 'complete':
        return <Tag type="green">Complete</Tag>;
      case 'error':
        return <Tag type="red">Error</Tag>;
    }
  };

  return (
    <div className="agent-status">
      {getStatusTag()}
      {status === 'analyzing' || status === 'reviewing' ? (
        <ProgressIndicator currentIndex={currentStep} spaceEqually>
          <ProgressStep label="Code Analysis" />
          <ProgressStep label="Security Scan" />
          <ProgressStep label="Quality Check" />
          <ProgressStep label="Generate Report" />
        </ProgressIndicator>
      ) : null}
    </div>
  );
}
```

### 4. Security Findings Display
```typescript
import {
  Accordion,
  AccordionItem,
  Tag,
  CodeSnippet
} from '@carbon/react';
import { Warning, Error, Information } from '@carbon/icons-react';

interface SecurityFinding {
  id: string;
  severity: 'critical' | 'high' | 'medium' | 'low';
  title: string;
  description: string;
  file: string;
  line: number;
  code: string;
  recommendation: string;
}

export function SecurityFindingsPanel({ findings }: { findings: SecurityFinding[] }) {
  const getSeverityIcon = (severity: string) => {
    switch (severity) {
      case 'critical':
      case 'high':
        return <Error size={20} />;
      case 'medium':
        return <Warning size={20} />;
      default:
        return <Information size={20} />;
    }
  };

  const getSeverityType = (severity: string) => {
    switch (severity) {
      case 'critical':
        return 'red';
      case 'high':
        return 'magenta';
      case 'medium':
        return 'yellow';
      default:
        return 'blue';
    }
  };

  return (
    <Accordion>
      {findings.map((finding) => (
        <AccordionItem
          key={finding.id}
          title={
            <div className="finding-title">
              {getSeverityIcon(finding.severity)}
              <span>{finding.title}</span>
              <Tag type={getSeverityType(finding.severity)}>
                {finding.severity.toUpperCase()}
              </Tag>
            </div>
          }
        >
          <div className="finding-details">
            <p>{finding.description}</p>
            <div className="finding-location">
              <strong>Location:</strong> {finding.file}:{finding.line}
            </div>
            <CodeSnippet type="multi" feedback="Copied">
              {finding.code}
            </CodeSnippet>
            <div className="finding-recommendation">
              <strong>Recommendation:</strong>
              <p>{finding.recommendation}</p>
            </div>
          </div>
        </AccordionItem>
      ))}
    </Accordion>
  );
}
```

## Theming and Customization

### 1. Theme Toggle
```typescript
import { useState } from 'react';
import { Theme } from '@carbon/react';
import { Asleep, Light } from '@carbon/icons-react';
import { Button } from '@carbon/react';

export function ThemeProvider({ children }: { children: React.ReactNode }) {
  const [theme, setTheme] = useState<'white' | 'g100'>('g100');

  const toggleTheme = () => {
    setTheme(theme === 'white' ? 'g100' : 'white');
  };

  return (
    <Theme theme={theme}>
      <div className="theme-toggle">
        <Button
          kind="ghost"
          size="sm"
          renderIcon={theme === 'white' ? Asleep : Light}
          iconDescription="Toggle theme"
          onClick={toggleTheme}
          hasIconOnly
        />
      </div>
      {children}
    </Theme>
  );
}
```

### 2. Custom SCSS with Carbon Tokens
```scss
// styles/components/custom-card.module.scss
@use '@carbon/react/scss/spacing' as *;
@use '@carbon/react/scss/theme' as *;
@use '@carbon/react/scss/type' as *;

.custom-card {
  background-color: $layer-01;
  padding: $spacing-05;
  border-radius: 4px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);

  .card-header {
    @include type-style('heading-03');
    color: $text-primary;
    margin-bottom: $spacing-03;
  }

  .card-content {
    @include type-style('body-01');
    color: $text-secondary;
  }

  &:hover {
    background-color: $layer-hover-01;
  }
}
```

### 3. Responsive Design with Carbon Breakpoints
```scss
@use '@carbon/react/scss/breakpoint' as *;

.dashboard-grid {
  display: grid;
  gap: 1rem;

  @include breakpoint(sm) {
    grid-template-columns: 1fr;
  }

  @include breakpoint(md) {
    grid-template-columns: repeat(2, 1fr);
  }

  @include breakpoint(lg) {
    grid-template-columns: repeat(4, 1fr);
  }
}
```

## Accessibility Best Practices

### 1. Keyboard Navigation
- Ensure all interactive elements are keyboard accessible
- Use proper focus management with Carbon components
- Implement skip links for main content areas
- Use `aria-label` and `aria-describedby` appropriately

### 2. Screen Reader Support
```typescript
import { ScreenReaderOnly } from '@carbon/react';

export function AccessibleMetric({ label, value }: { label: string; value: string }) {
  return (
    <div>
      <ScreenReaderOnly>{label}</ScreenReaderOnly>
      <div aria-label={`${label}: ${value}`}>
        <span className="metric-value">{value}</span>
      </div>
    </div>
  );
}
```

### 3. Color Contrast
- Use Carbon's built-in color tokens for WCAG AA compliance
- Test with Carbon's contrast checker
- Avoid relying solely on color to convey information

### 4. Form Accessibility
```typescript
import { TextInput, FormLabel } from '@carbon/react';

export function AccessibleForm() {
  return (
    <div>
      <FormLabel htmlFor="repo-name">
        Repository Name
        <span aria-label="required">*</span>
      </FormLabel>
      <TextInput
        id="repo-name"
        labelText=""
        placeholder="Enter repository name"
        required
        invalid={false}
        invalidText="Repository name is required"
        aria-required="true"
      />
    </div>
  );
}
```

## Performance Optimization

### 1. Code Splitting
```typescript
import dynamic from 'next/dynamic';

// Lazy load heavy components
const CodeDiffViewer = dynamic(() => import('./CodeDiffViewer'), {
  loading: () => <Loading />,
  ssr: false
});

const ChartsPanel = dynamic(() => import('./ChartsPanel'), {
  loading: () => <CardSkeleton />
});
```

### 2. Memoization
```typescript
import { memo, useMemo } from 'react';

export const MetricTile = memo(({ title, value, change }: MetricTileProps) => {
  const changeColor = useMemo(() => {
    return change >= 0 ? 'positive' : 'negative';
  }, [change]);

  return (
    <Tile>
      {/* Component content */}
    </Tile>
  );
});
```


## Test Data Management

### Backend Test Fixtures

```python
# tests/factories.py
import factory
from factory import fuzzy
from datetime import datetime, timedelta
from src.models.pull_request import PullRequest
from src.models.review import Review
from src.models.user import User

class UserFactory(factory.Factory):
    """Factory for creating test users."""
    
    class Meta:
        model = User
    
    id = factory.Sequence(lambda n: n)
    username = factory.Faker('user_name')
    email = factory.Faker('email')
    github_id = factory.Sequence(lambda n: f"github_{n}")
    created_at = factory.LazyFunction(datetime.utcnow)

class PullRequestFactory(factory.Factory):
    """Factory for creating test pull requests."""
    
    class Meta:
        model = PullRequest
    
    id = factory.Sequence(lambda n: n)
    number = factory.Sequence(lambda n: n)
    title = factory.Faker('sentence')
    repository = factory.Faker('slug')
    author = factory.SubFactory(UserFactory)
    status = fuzzy.FuzzyChoice(['open', 'closed', 'merged'])
    created_at = factory.LazyFunction(datetime.utcnow)
    updated_at = factory.LazyFunction(datetime.utcnow)

class ReviewFactory(factory.Factory):
    """Factory for creating test reviews."""
    
    class Meta:
        model = Review
    
    id = factory.Sequence(lambda n: n)
    pull_request = factory.SubFactory(PullRequestFactory)
    status = fuzzy.FuzzyChoice(['pending', 'completed', 'failed'])
    security_score = fuzzy.FuzzyInteger(0, 100)
    code_quality_score = fuzzy.FuzzyInteger(0, 100)
    findings = factory.List([
        factory.Dict({
            'type': fuzzy.FuzzyChoice(['security', 'quality', 'architecture']),
            'severity': fuzzy.FuzzyChoice(['low', 'medium', 'high', 'critical']),
            'message': factory.Faker('sentence')
        })
        for _ in range(3)
    ])
    created_at = factory.LazyFunction(datetime.utcnow)

# Usage in tests
def test_example():
    user = UserFactory()
    pr = PullRequestFactory(author=user)
    review = ReviewFactory(pull_request=pr)
```


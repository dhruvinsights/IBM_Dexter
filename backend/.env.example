DEXTER_APP_NAME=IBM Dexter Backend
DEXTER_APP_VERSION=0.1.0
DEXTER_APP_ENV=development
DEXTER_APP_HOST=0.0.0.0
DEXTER_APP_PORT=8000
DEXTER_DEBUG=false

DEXTER_DATABASE_URL=sqlite+aiosqlite:///./dexter.db
DEXTER_TEST_DATABASE_URL=sqlite+aiosqlite:///./dexter_test.db
DEXTER_DATABASE_ECHO=false
DEXTER_DATABASE_POOL_SIZE=5
DEXTER_DATABASE_MAX_OVERFLOW=10

DEXTER_REDIS_URL=redis://localhost:6379/0

DEXTER_JWT_SECRET_KEY=change-me-in-production
DEXTER_JWT_ALGORITHM=HS256
DEXTER_ACCESS_TOKEN_EXPIRE_MINUTES=60
DEXTER_REFRESH_TOKEN_EXPIRE_MINUTES=10080

DEXTER_API_KEY_HEADER_NAME=X-API-Key
DEXTER_API_KEY=dexter-local-api-key

# MVP / hackathon: leave false (open API). Set true to require JWT or X-API-Key on data routes.
# DEXTER_REQUIRE_API_BEARER_AUTH=false

DEXTER_GITHUB_TOKEN=
DEXTER_GITHUB_WEBHOOK_SECRET=github-webhook-secret
DEXTER_GITLAB_TOKEN=
DEXTER_GITLAB_WEBHOOK_SECRET=gitlab-webhook-secret

# Legacy AI Provider (deprecated, use LLM_PROVIDER instead)
DEXTER_AI_PROVIDER=mock

# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================
# Primary LLM provider: watsonx (default for hosted), openai, ollama, anthropic, cohere
DEXTER_LLM_PROVIDER=watsonx

# ----------------------------------------------------------------------------
# Ollama (local or reachable URL — ideal for desktop / Electron; see DEXTER_APP_ENV)
# ----------------------------------------------------------------------------
# Install: https://ollama.com/download — Hosted/cloud Dexter cannot reach your laptop localhost.
DEXTER_OLLAMA_BASE_URL=http://localhost:11434
DEXTER_OLLAMA_MODEL=qwen2.5-coder:14b

# ----------------------------------------------------------------------------
# IBM Watsonx Configuration (Enterprise AI Platform)
# ----------------------------------------------------------------------------
# Get credentials from: https://cloud.ibm.com/
DEXTER_WATSONX_API_KEY=
DEXTER_WATSONX_PROJECT_ID=
DEXTER_WATSONX_URL=https://us-south.ml.cloud.ibm.com
DEXTER_WATSONX_MODEL=ibm/granite-13b-chat-v2

# ----------------------------------------------------------------------------
# Optional API Keys (User-provided)
# ----------------------------------------------------------------------------
# OpenAI (chat + optional embeddings)
DEXTER_OPENAI_API_KEY=
DEXTER_OPENAI_MODEL=gpt-4o-mini

# Embeddings for knowledge base / RAG (ollama | openai). Must match DEXTER_EMBEDDING_DIMENSION ↔ Db2 VECTOR column.
DEXTER_EMBEDDING_PROVIDER=openai
DEXTER_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
DEXTER_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEXTER_EMBEDDING_DIMENSION=1536

# Show “hosted Ollama” guidance even in development (optional)
DEXTER_FORCE_HOSTED_OLLAMA_NOTICE=false

# Anthropic Claude Configuration
DEXTER_ANTHROPIC_API_KEY=
DEXTER_ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Cohere Configuration
DEXTER_COHERE_API_KEY=
DEXTER_COHERE_MODEL=command-r-plus

# ----------------------------------------------------------------------------
# LLM Generation Settings
# ----------------------------------------------------------------------------
DEXTER_LLM_TEMPERATURE=0.7
DEXTER_LLM_MAX_TOKENS=2000
DEXTER_LLM_TIMEOUT=60

# ============================================================================
# VECTOR DATABASE CONFIGURATION
# ============================================================================
# Vector database type: inmemory (dev only) or db2 (IBM Db2 via langchain-db2)
DEXTER_VECTOR_DB_TYPE=db2

# ----------------------------------------------------------------------------
# IBM Db2 Vector Database Configuration
# ----------------------------------------------------------------------------
# Use IBM Db2 as vector database for production deployments
# Requires: pip install langchain-db2 ibm-db ibm-db-sa

# LangChain Db2 Integration (Recommended)
# Use official langchain-db2 package for better LangChain integration
USE_LANGCHAIN_DB2=true

# Db2 Connection Settings
DEXTER_DB2_DATABASE=DEXTER
DEXTER_DB2_HOSTNAME=localhost
DEXTER_DB2_PORT=50000
DEXTER_DB2_PROTOCOL=TCPIP
DEXTER_DB2_UID=db2inst1
DEXTER_DB2_PWD=your_password_here
DEXTER_DB2_SCHEMA=DEXTER
DEXTER_DB2_TABLE_NAME=VECTOR_EMBEDDINGS
DEXTER_DB2_EMBEDDING_DIMENSION=384

DEXTER_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
DEXTER_LOG_LEVEL=INFO
# ============================================================================
# IBM DEXTER - ENVIRONMENT CONFIGURATION
# ============================================================================
# Complete configuration for IBM Dexter AI Code Reviewer
# Last Updated: 2026-05-16
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
DEXTER_APP_NAME=IBM Dexter Backend
DEXTER_APP_VERSION=0.1.0
DEXTER_APP_ENV=development
DEXTER_APP_HOST=0.0.0.0
DEXTER_APP_PORT=8000
DEXTER_DEBUG=false

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL/SQLite)
# ============================================================================
# Main application database for users, reviews, repositories, etc.
# For production, use PostgreSQL: postgresql+asyncpg://user:pass@host:5432/dbname
# For development/testing, SQLite is sufficient
DEXTER_DATABASE_URL=sqlite+aiosqlite:///./dexter.db
DEXTER_TEST_DATABASE_URL=sqlite+aiosqlite:///./dexter_test.db
DEXTER_DATABASE_ECHO=false
DEXTER_DATABASE_POOL_SIZE=5
DEXTER_DATABASE_MAX_OVERFLOW=10

# ============================================================================
# REDIS CONFIGURATION (Caching & Task Queue)
# ============================================================================
# Redis is used for caching and Celery task queue
# Install: brew install redis (macOS) or apt-get install redis (Linux)
# Start: redis-server
DEXTER_REDIS_URL=redis://localhost:6379/0

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================
# JWT Configuration
# CRITICAL: Change JWT_SECRET_KEY in production to a strong random value
# Generate with: openssl rand -hex 32
DEXTER_JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
DEXTER_JWT_ALGORITHM=HS256
DEXTER_ACCESS_TOKEN_EXPIRE_MINUTES=60
DEXTER_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# API Key Configuration
DEXTER_API_KEY_HEADER_NAME=X-API-Key
DEXTER_API_KEY=dexter-local-api-key-change-in-production

# ============================================================================
# VERSION CONTROL INTEGRATION
# ============================================================================
# GitHub Configuration
# Get token from: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user, admin:repo_hook
DEXTER_GITHUB_TOKEN=ghp_zHXGUS4ezO3hgZA5Exj8NZmS08FWpD1EERRL
DEXTER_GITHUB_WEBHOOK_SECRET=github-webhook-secret-change-in-production

# GitLab Configuration
# Get token from: https://gitlab.com/-/profile/personal_access_tokens
# Required scopes: api, read_repository, read_user
DEXTER_GITLAB_TOKEN=your_gitlab_token_here
DEXTER_GITLAB_WEBHOOK_SECRET=gitlab-webhook-secret-change-in-production

# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================
# Primary LLM provider: ollama, watsonx, openai, anthropic, cohere
DEXTER_LLM_PROVIDER=ollama

# Legacy AI Provider (deprecated, use LLM_PROVIDER instead)
DEXTER_AI_PROVIDER=mock

# ----------------------------------------------------------------------------
# Ollama Configuration (Primary for Testing - Local LLM)
# ----------------------------------------------------------------------------
# Install: curl -fsSL https://ollama.ai/install.sh | sh
# Pull model: ollama pull llama3
# Start service: ollama serve
DEXTER_OLLAMA_BASE_URL=http://localhost:11434
DEXTER_OLLAMA_MODEL=llama3

# ----------------------------------------------------------------------------
# IBM Watsonx Configuration (Enterprise AI Platform)
# ----------------------------------------------------------------------------
# Get credentials from: https://cloud.ibm.com/
# Create project and get API key from IBM Cloud
DEXTER_WATSONX_API_KEY=your_watsonx_api_key_here
DEXTER_WATSONX_PROJECT_ID=your_watsonx_project_id_here
DEXTER_WATSONX_URL=https://us-south.ml.cloud.ibm.com
DEXTER_WATSONX_MODEL=ibm/granite-13b-chat-v2

# ----------------------------------------------------------------------------
# Optional API Keys (User-provided)
# ----------------------------------------------------------------------------
# OpenAI Configuration
# Get API key from: https://platform.openai.com/api-keys
DEXTER_OPENAI_API_KEY=your_openai_api_key_here
DEXTER_OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude Configuration
# Get API key from: https://console.anthropic.com/
DEXTER_ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEXTER_ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Cohere Configuration
# Get API key from: https://dashboard.cohere.ai/api-keys
DEXTER_COHERE_API_KEY=your_cohere_api_key_here
DEXTER_COHERE_MODEL=command-r-plus

# ----------------------------------------------------------------------------
# LLM Generation Settings
# ----------------------------------------------------------------------------
DEXTER_LLM_TEMPERATURE=0.7
DEXTER_LLM_MAX_TOKENS=2000
DEXTER_LLM_TIMEOUT=60

# ============================================================================
# VECTOR DATABASE CONFIGURATION
# ============================================================================
# Vector database type: inmemory, db2, qdrant, weaviate, chromadb
DEXTER_VECTOR_DB_TYPE=db2

# Use LangChain's official Db2 integration (db2vs component)
DEXTER_USE_LANGCHAIN_DB2=true

# ----------------------------------------------------------------------------
# IBM Db2 Vector Store Configuration
# ----------------------------------------------------------------------------
# CRITICAL: These are production credentials - secure appropriately
# Connection details for IBM Db2 vector database
DEXTER_DB2_DATABASE=TESTDB
DEXTER_DB2_HOSTNAME=Geetika-5y420-x86.dev.fyre.ibm.com
DEXTER_DB2_PORT=50000
DEXTER_DB2_PROTOCOL=TCPIP
DEXTER_DB2_UID=Geetika
DEXTER_DB2_PWD=Geet#246

# Schema for all vector tables (db2vs will create tables as needed)
DEXTER_DB2_SCHEMA=DEXTER

# Table prefix (optional) - db2vs will create: DEXTER_CODE, DEXTER_DOCS, etc.
# Leave empty for no prefix, or set to "DEXTER" for DEXTER_<collection_name>
DEXTER_DB2_TABLE_PREFIX=DEXTER

# Embedding dimension (default: 384 for nomic-embed-text)
DEXTER_EMBEDDING_DIMENSION=384

# ----------------------------------------------------------------------------
# Alternative Vector Database Options (Uncomment to use)
# ----------------------------------------------------------------------------
# Qdrant Configuration
# DEXTER_QDRANT_URL=http://localhost:6333
# DEXTER_QDRANT_API_KEY=your_qdrant_api_key_here
# DEXTER_QDRANT_COLLECTION=dexter_embeddings

# Weaviate Configuration
# DEXTER_WEAVIATE_URL=http://localhost:8080
# DEXTER_WEAVIATE_API_KEY=your_weaviate_api_key_here
# DEXTER_WEAVIATE_CLASS=DexterDocument

# ChromaDB Configuration
# DEXTER_CHROMADB_PATH=./chromadb
# DEXTER_CHROMADB_COLLECTION=dexter_embeddings

# ============================================================================
# EMBEDDING SERVICE CONFIGURATION
# ============================================================================
# Embedding model configuration for text vectorization
# Options: openai, huggingface, sentence-transformers, nomic
DEXTER_EMBEDDING_PROVIDER=sentence-transformers
DEXTER_EMBEDDING_MODEL=all-MiniLM-L6-v2
DEXTER_EMBEDDING_BATCH_SIZE=32

# For OpenAI embeddings (if using)
# DEXTER_OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# For HuggingFace embeddings (if using)
# DEXTER_HUGGINGFACE_API_KEY=your_huggingface_api_key_here
# DEXTER_HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================================
# CELERY TASK QUEUE CONFIGURATION
# ============================================================================
# Celery configuration for background tasks
DEXTER_CELERY_BROKER_URL=redis://localhost:6379/1
DEXTER_CELERY_RESULT_BACKEND=redis://localhost:6379/2
DEXTER_CELERY_TASK_SERIALIZER=json
DEXTER_CELERY_RESULT_SERIALIZER=json
DEXTER_CELERY_ACCEPT_CONTENT=json
DEXTER_CELERY_TIMEZONE=UTC
DEXTER_CELERY_ENABLE_UTC=true

# Task routing and queues
DEXTER_CELERY_TASK_ROUTES_AI_ANALYSIS=ai_analysis
DEXTER_CELERY_TASK_ROUTES_CODE_REVIEW=code_review
DEXTER_CELERY_TASK_ROUTES_WEBHOOK_PROCESSING=webhook_processing

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
# Logging Configuration
DEXTER_LOG_LEVEL=INFO
DEXTER_LOG_FORMAT=json
DEXTER_LOG_FILE=logs/dexter.log

# Metrics and Health Checks
DEXTER_METRICS_ENABLED=true
DEXTER_HEALTH_CHECK_INTERVAL=30
DEXTER_PERFORMANCE_MONITORING=true

# Sentry Error Tracking (Optional)
# DEXTER_SENTRY_DSN=your_sentry_dsn_here
# DEXTER_SENTRY_ENVIRONMENT=development

# ============================================================================
# RATE LIMITING & THROTTLING
# ============================================================================
# API rate limiting configuration
DEXTER_RATE_LIMIT_ENABLED=true
DEXTER_RATE_LIMIT_REQUESTS_PER_MINUTE=100
DEXTER_RATE_LIMIT_BURST=20

# LLM API rate limiting
DEXTER_LLM_RATE_LIMIT_REQUESTS_PER_MINUTE=30
DEXTER_LLM_RATE_LIMIT_TOKENS_PER_MINUTE=50000

# ============================================================================
# WEBHOOK CONFIGURATION
# ============================================================================
# Webhook processing settings
DEXTER_WEBHOOK_TIMEOUT=30
DEXTER_WEBHOOK_RETRY_ATTEMPTS=3
DEXTER_WEBHOOK_RETRY_DELAY=5

# Webhook security
DEXTER_WEBHOOK_VERIFY_SSL=true
DEXTER_WEBHOOK_MAX_PAYLOAD_SIZE=10485760  # 10MB

# ============================================================================
# CODE ANALYSIS CONFIGURATION
# ============================================================================
# Code analysis settings
DEXTER_MAX_FILE_SIZE_MB=5
DEXTER_MAX_FILES_PER_PR=100
DEXTER_SUPPORTED_LANGUAGES=python,javascript,typescript,java,go,rust,cpp,c,csharp

# Analysis timeouts
DEXTER_ANALYSIS_TIMEOUT_SECONDS=300
DEXTER_EMBEDDING_TIMEOUT_SECONDS=60

# ============================================================================
# CORS & SECURITY HEADERS
# ============================================================================
# CORS configuration for frontend integration
DEXTER_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173
DEXTER_CORS_ALLOW_CREDENTIALS=true
DEXTER_CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
DEXTER_CORS_ALLOW_HEADERS=*

# Security headers
DEXTER_SECURITY_HEADERS_ENABLED=true
DEXTER_HSTS_MAX_AGE=31536000
DEXTER_CONTENT_SECURITY_POLICY=default-src 'self'

# ============================================================================
# DEVELOPMENT & TESTING
# ============================================================================
# Development mode settings
DEXTER_DEV_MODE=true
DEXTER_AUTO_RELOAD=true
DEXTER_MOCK_EXTERNAL_APIS=false

# Testing configuration
DEXTER_TEST_MODE=false
DEXTER_TEST_SKIP_AUTH=false
DEXTER_TEST_MOCK_LLM=false

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Feature toggles for gradual rollout
DEXTER_FEATURE_MULTI_AGENT_ANALYSIS=true
DEXTER_FEATURE_ADVANCED_SECURITY_SCAN=true
DEXTER_FEATURE_COMPLIANCE_CHECKING=true
DEXTER_FEATURE_ARCHITECTURE_ANALYSIS=true
DEXTER_FEATURE_PERFORMANCE_ANALYSIS=true

# Experimental features
DEXTER_EXPERIMENTAL_AI_SUGGESTIONS=false
DEXTER_EXPERIMENTAL_AUTO_FIX=false
DEXTER_EXPERIMENTAL_LEARNING_MODE=false

# ============================================================================
# BACKUP & RECOVERY
# ============================================================================
# Database backup settings
DEXTER_BACKUP_ENABLED=false
DEXTER_BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
DEXTER_BACKUP_RETENTION_DAYS=30
DEXTER_BACKUP_LOCATION=./backups

# ============================================================================
# INTEGRATION SETTINGS
# ============================================================================
# Slack integration (Optional)
# DEXTER_SLACK_BOT_TOKEN=your_slack_bot_token_here
# DEXTER_SLACK_SIGNING_SECRET=your_slack_signing_secret_here
# DEXTER_SLACK_DEFAULT_CHANNEL=#code-reviews

# Microsoft Teams integration (Optional)
# DEXTER_TEAMS_WEBHOOK_URL=your_teams_webhook_url_here

# Jira integration (Optional)
# DEXTER_JIRA_URL=https://your-domain.atlassian.net
# DEXTER_JIRA_USERNAME=your_jira_username_here
# DEXTER_JIRA_API_TOKEN=your_jira_api_token_here

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================
# Connection pool settings
DEXTER_DB_POOL_SIZE=10
DEXTER_DB_MAX_OVERFLOW=20
DEXTER_DB_POOL_TIMEOUT=30
DEXTER_DB_POOL_RECYCLE=3600

# HTTP client settings
DEXTER_HTTP_TIMEOUT=30
DEXTER_HTTP_MAX_CONNECTIONS=100
DEXTER_HTTP_MAX_KEEPALIVE_CONNECTIONS=20

# Memory management
DEXTER_MAX_MEMORY_MB=2048
DEXTER_GARBAGE_COLLECTION_THRESHOLD=0.8

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
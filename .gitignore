# ============================================
# IBM Dexter - Comprehensive .gitignore
# ============================================

# ============================================
# Python Virtual Environments (AGGRESSIVE)
# ============================================
# Standard venv names
venv/
env/
ENV/
.venv/
.env/

# Backend virtual environments - catch ALL subdirectories with bin/python
backend/venv/
backend/env/
backend/*/bin/
backend/*/lib/
backend/*/include/
backend/*/pyvenv.cfg
backend/*/share/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing
htmlcov/
.tox/
.coverage
.coverage.*
.cache
.pytest_cache/

# ============================================
# Environment Variables & Secrets
# ============================================
.env
.env.local
.env.*.local
*.env
.envrc

# API Keys and Secrets
secrets/
*.key
*.pem
credentials.json
*-credentials.json

# ============================================
# Node.js / Frontend
# ============================================
node_modules/
frontend/node_modules/

# Production build
frontend/dist/
frontend/build/

# Testing
frontend/coverage/

# Logs
npm-debug.log*
yarn-debug.log*
*.log

# ============================================
# Database Files
# ============================================
*.db
*.sqlite
*.sqlite3
dexter.db
*.db-journal

# Vector Store Data
chromadb_data/
vector_store/
embeddings/
qdrant_data/
weaviate_data/

# ============================================
# OS Files
# ============================================
.DS_Store
Thumbs.db
*.swp
*.swo

# ============================================
# IDE & Editors
# ============================================
.vscode/*
!.vscode/settings.json
.idea/
*.iml
*.iws

# ============================================
# Temporary & Cache Files
# ============================================
*.bak
.cache/
*.tmp
*.temp